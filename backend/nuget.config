<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Use only the public NuGet feed so builds are reproducible on any machine and in CI. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
