{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Cors": {
    "AllowedOrigins": []
  },

  "Transcription": {
    "Provider": "Groq",
    "MaxUploadMegabytes": 25,
    "AudioBitrateKbps": 32,
    "RequestTimeoutSeconds": 180,
    "Groq": {
      "Model": "whisper-large-v3-turbo",
      "TranslationModel": "whisper-large-v3"
    },
    "HuggingFace": {
      "Model": "openai/whisper-large-v3"
    },
    "Retry": {
      "MaxRetries": 2,
      "BaseDelaySeconds": 2,
      "MaxDelaySeconds": 15
    }
  },

  "Demo": {
    "AllowYouTube": true,
    "MaxDurationMinutes": 15,
    "MaxUploadMegabytes": 10,
    "PermitLimitPerWindow": 5,
    "WindowMinutes": 10,
    "DailyLimit": 40,
    "MaxConcurrentJobs": 2
  }
}
