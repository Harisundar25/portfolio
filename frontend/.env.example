# Copy to .env.local for local overrides. Vite only exposes variables prefixed with VITE_.
# These values are embedded into the public JavaScript bundle — never put secrets here.

# Base URL of the TranscriptAI API, without a trailing slash.
# Leave empty during local development (Vite proxies /api to http://localhost:5080).
# Production example: https://<your-api-app>.azurewebsites.net
VITE_API_BASE_URL=

# Optional EmailJS credentials for the contact form.
# When empty, the form falls back to opening the visitor's email app (mailto:).
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
